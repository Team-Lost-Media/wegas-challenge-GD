; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Wega's Challenge: WEGAKILL"
config/description="wega's challenge but with jumping, dashing and STYLE
based off of wegas-challenge-gd by xetheon"
config/version="1.0"
config/tags=PackedStringArray("random\'s_main_project", "shitpost", "wega")
run/main_scene="res://scenes/menus/main/mainMenu.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="uid://bei5enh7oagrt"

[autoload]

SettingsHandler="*res://scenes/autoload/SettingsHandler.gd"
GameManager="*res://scenes/autoload/GameManager.gd"
Save="*res://scenes/autoload/save.gd"
Global="*res://scenes/autoload/global.gd"
StyleSFX="*res://scenes/autoload/style sfx.tscn"
SongCredits="*res://scenes/autoload/song credits.tscn"
Achievements="*res://scenes/autoload/achievements.tscn"

[debug_draw_3d]

settings/addon_root_folder="res://addons/debug_draw_3d"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="viewport"
window/stretch/aspect="expand"
mouse_cursor/description=""
mouse_cursor/name="Wegas Challenge GD port"

[dotnet]

project/assembly_name="player-template"

[editor]

movie_writer/movie_file="C:/Users/natep/Downloads/New Recording (Wegas Challenge GD).avi"

[editor_plugins]

enabled=PackedStringArray()

[file_customization]

folder_colors={
